# Shared Auth & Internal Security
JWT_SECRET=pizza-shop-super-secret-jwt-key-2026
JWT_EXPIRES_IN=1d
INTERNAL_API_KEY=pizza-internal-service-key-2026

# PostgreSQL (Docker service: postgres)
POSTGRES_USER=pizza
POSTGRES_PASSWORD=pizza123

# RabbitMQ (Docker service: rabbitmq)
RABBITMQ_URL=amqp://pizza:pizza123@localhost:5672

# Mailtrap SMTP (get credentials from https://mailtrap.io)
# Leave empty to use local mock email transport + console logging
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
SHOP_OWNER_EMAIL=owner@pizzashop.local
EMAIL_FROM="Pizza Shop <no-reply@pizzashop.local>"
