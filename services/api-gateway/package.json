{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "Unified API Gateway with JWT verification, RBAC, and reverse proxy",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
